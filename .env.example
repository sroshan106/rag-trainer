DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_db
OLLAMA_BASE_URL=http://localhost:11434
RAG_CITATIONS=true
RAG_RERANK=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_DEVICE=cpu
RAG_RERANK_MAX_LENGTH=512
RAG_FETCH_K=20
RAG_NUM_CTX=8192
RAG_NUM_CTX_QWEN3=3072
RAG_RELEVANCE_FLOOR=0.56
RAG_RELEVANCE_RATIO=0.9
RAG_TRACE=false

# Ingest embedding throughput. The embedding model runs with n_slots=1 on
# this Ollama build regardless of OLLAMA_NUM_PARALLEL, so concurrent workers
# don't help -- fewer, larger requests (RAG_EMBED_BATCH) is the real lever.
RAG_EMBED_BATCH=1024
RAG_EMBED_WORKERS=1
OLLAMA_NUM_PARALLEL=1
